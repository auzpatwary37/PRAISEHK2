  <groupId>MATSim-HK</groupId>
  <artifactId>MATSim-HK</artifactId>
  <version>11.0</version>
  <name>MATSim-HK</name>
  <description>
    Hong Kong MATSim extension fork (dynamic transit router, fare handling,
    HK network/population builders). Legacy reference implementation, imported
    from the local-only fork (gitlab.com/leeenoch1005/MATSim-HK, branch MAAS,
    HEAD 7ada92e) using the WORKING-TREE state, because the committed pom had
    the MATSim dependencies commented out and could not compile.
    See docs/modernization/PRAISE_MATSIMHK_RELATIONSHIP.md.
  </description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <repositories>
  <repository>
    <id>matsim</id>
    <name>MATSim Maven repository</name>
    <url>https://repo.matsim.org/repository/matsim/</url>
  </repository>

