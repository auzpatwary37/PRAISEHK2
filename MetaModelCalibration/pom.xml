		<!-- ============================================================
		     VENDORED LOCAL DEPENDENCY.

		     jcool-core.jar is not published to any public Maven
		     repository. It is required for
		       cz.cvut.fit.jcool.core.*   (ObjectiveFunction, Point,
		                                   Gradient, Hessian)
		       cz.cvut.fit.jcool.utils.*  (CentralDifferenceHessian)
		     used by AnalyticalModelOptimizerImpl and HessianObjective.

		     systemPath is used deliberately so the build is reproducible
		     offline and needs no prior `install:install-file`.
		     See docs/modernization/DEPENDENCIES.md.
		     ============================================================ -->
		<dependency>
			<groupId>cz.cvut.fit</groupId>
			<artifactId>jcool-core</artifactId>
			<version>1.0</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/src/main/resources/jcool-core.jar</systemPath>
		</dependency>

